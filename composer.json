{
    "name": "pixelguru95/auth",
    "description": "Package d’authentification avancée pour Laravel/Filament",
    "type": "library",
    "license": "MIT",
    "authors": [
      {
        "name": "PixelGuru95",
        "email": "orvilleberanger@gmail.com"
      }
